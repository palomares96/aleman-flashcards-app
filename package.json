    "chart.js": "^4.5.0",
    "dotenv": "^17.2.2",
    "firebase": "^10.14.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "ts-fsrs": "^5.4.2"
