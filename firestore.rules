rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function shared(uid) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(uid)).data.get('shareVocabulary', false) == true
        && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(uid));
    }
    match /users/{uid} {
      allow read: if owner(uid);
      // Account creation/identity and tier are controlled by server functions.
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareVocabulary', 'achievements'])
        && request.resource.data.get('shareVocabulary', false) is bool;
      match /words/{wordId} {
        allow read: if owner(uid) || shared(uid);
        allow write: if owner(uid);
      }
      match /friends/{friendId} { allow read: if owner(uid); }
      match /{collection}/{id} {
        allow read, write: if owner(uid) && collection in ['progress', 'studyProgress', 'studyDays', 'sentenceAttempts', 'user_events', 'savedExamples', 'contrastProgress', 'contrastAttempts'];
      }
      match /reviewEvents/{eventId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.id == eventId
          && request.resource.data.rating in [1, 2, 3, 4]
          && request.resource.data.direction in ['de-es', 'es-de', 'listen'];
      }
    }
    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
    }
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from_uid == request.auth.uid || resource.data.to_uid == request.auth.uid);
    }
    match /dailyStats/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; }
    match /categories/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['name_es', 'name_de', 'createdAt', 'createdBy'])
        && request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid
        && request.resource.data.name_es is string && request.resource.data.name_es.size() <= 100
        && request.resource.data.name_de is string && request.resource.data.name_de.size() <= 100;
    }
  }
}
